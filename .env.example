# Token compartido para acceder al dashboard.
# Genera uno fuerte: openssl rand -hex 32
ADMIN_TOKEN=cambiar-esto-por-un-token-fuerte

# Dominio para Caddy (auto-TLS con Let's Encrypt)
# Para dev local, dejar 'localhost' (Caddy usa cert local)
# Para producción, poner el dominio real, ej: td.sanvest.cl
DOMAIN=localhost

# Email para notificaciones de Let's Encrypt (solo producción)
EMAIL=admin@example.com
