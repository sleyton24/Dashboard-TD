# Entorno
JARVIS_ENV=dev
JARVIS_ADMIN_EMAIL=seba@sanvest.cl

# Postgres (DSN async — driver asyncpg)
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis

# Redis para arq + pub/sub
REDIS_URL=redis://localhost:6379/0

# Modelo local (Ollama). Único proveedor permitido — nada de APIs externas (Ley 21.719).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_TIMEOUT_S=300

# Datos corporativos — todos en Postgres del VPS (read-only). Una sola
# instancia, múltiples bases. Idealmente usuario dedicado `jarvis_ro` con
# solo SELECT sobre las tablas relevantes.
# Ej: postgresql+asyncpg://jarvis_ro:****@localhost:5432/lar
LAR_PG_DSN=
ICEMM_PG_DSN=
ATEMPORA_PG_DSN=

# M365 / SharePoint (client credentials flow)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# CORS: orígenes permitidos (CSV). Default '*' es OK para dev local y para
# el VPS donde Panel TD + JARVIS comparten host. Restringir cuando haya
# dominio real, ej: CORS_ALLOW_ORIGINS=https://td.sanvest.cl,https://jarvis.sanvest.cl
CORS_ALLOW_ORIGINS=*

# Adjuntos: dónde guardar los archivos que sube el usuario al invocar.
# El directorio debe ser escribible por el user de servicio (mismo del unit
# de systemd). Crear con:
#   sudo mkdir -p /var/lib/jarvis/attachments
#   sudo chown <deploy_user>:<deploy_user> /var/lib/jarvis/attachments
ATTACHMENTS_DIR=/var/lib/jarvis/attachments
# ATTACHMENT_MAX_BYTES=20971520    # 20 MB por archivo (default)
# ATTACHMENT_MAX_FILES=10          # archivos por invocación (default)

# Operación
JOB_TIMEOUT_S=300
MAX_STEPS_PER_JOB=50
