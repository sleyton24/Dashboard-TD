# Variables para probar el MCP standalone (fuera de Claude Desktop):
#   uv run jarvis-mcp
# En Claude Desktop estos valores van en el bloque `env` del mcpServers,
# no en un .env.

JARVIS_API_URL=http://localhost:8000
JARVIS_API_KEY=

# Tunable opcional:
# JARVIS_INVOKE_TIMEOUT_S=600
# JARVIS_HTTP_TIMEOUT_S=30
# JARVIS_POLL_INTERVAL_S=3.0
